page { background: #f7f8fb; color: #20304a; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; font-size: 15px; }
view, text, button, input, textarea { box-sizing: border-box; }
button { font-size: 14px; line-height: 1.5; border-radius: 12px; margin: 0; padding: 11px 16px; font-weight: 600; }
button::after { border: 0; }
/* The v2 built-in button:not([size="mini"]) has a fixed default width. */
button:not([size="mini"]) { width: auto; margin: 0; }
button[disabled] { opacity: .45; }
input, textarea { font-size: 16px; }
