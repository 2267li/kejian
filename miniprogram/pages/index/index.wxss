/* Allow grid children to shrink below native textarea/input intrinsic widths. */
.workspace,.help-grid,.field-grid{grid-template-columns:repeat(2,minmax(0,1fr))}
.card,.task-body{min-width:0}
button.full{width:100%;margin-top:14px}
.task button.check{width:27px;min-width:27px;max-width:27px;flex:0 0 27px}
.filters button.filter{flex:1;min-width:0}
/* Override v2's fixed button width so confirmation labels remain on one line. */
.action-row{align-items:center}
.action-row button.secondary,.action-row button.primary{width:auto;min-width:0;flex:0 0 auto;padding:11px 16px;font-size:14px;line-height:22px;white-space:nowrap}
.action-row button.grow{width:0;flex:1 1 0}
.action-row>text{flex-shrink:0;white-space:nowrap}
/* Keep example choices compact, including under WeChat v2 button defaults. */
.composer .reference-row{gap:12px;margin:16px 0 6px}
.composer .reference-hint{font-size:11px;line-height:1.7}
.composer button.primary.full{height:46px;margin:16px 0 0;padding:12px 10px;font-size:15px;line-height:22px;border-radius:12px;white-space:nowrap}
.example-section{margin-top:20px}
.example-label{color:#6b7890;font-size:12px;line-height:18px;margin-bottom:8px}
.composer .example-row{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px;margin:0}
.example-row button.chip{width:100%;min-width:0;height:44px;margin:0;padding:12px 4px;border:1px solid #e5eaf5;border-radius:10px;background:#f5f7fc;color:#52678f;font-size:12px;font-weight:500;line-height:18px;white-space:nowrap}
.composer-note{margin-top:16px;padding-top:12px;border-top:1px solid #edf0f6;color:#758198;font-size:11px;line-height:1.8}
.help-page{max-width:900px;margin:0 auto}
.help-header{margin-bottom:18px}
.help-heading{font-size:26px;font-weight:750;line-height:1.4;margin:7px 0}
.help-description{font-size:13px;line-height:1.75;color:#64738d}
.help-title{font-size:16px;font-weight:650;line-height:1.5;margin-bottom:6px}
.help-caption{font-size:11px;line-height:1.8;color:#738098}
.backup-summary{display:flex;align-items:center;gap:12px}
.backup-symbol{flex:0 0 40px;height:40px;border-radius:12px;background:#edf2ff;color:#365be5;font-size:24px;line-height:40px;text-align:center}
.backup-count{font-size:16px;font-weight:650;line-height:1.6}
.help-page button.full{min-width:0;height:44px;padding:11px 10px;font-size:14px;line-height:22px;border-radius:11px;white-space:nowrap}
.help-page .help-restore{background:#f2f5ff;border:1px solid #e0e7fb;padding:10px}
.action-caption{margin-top:7px}
.help-separator{border-top:1px solid #edf0f6;margin:18px 0}
.help-page button.help-disclosure{display:flex;align-items:center;justify-content:space-between;gap:8px;width:100%;min-width:0;min-height:48px;padding:12px 0;margin:0;background:transparent;color:#344968;font-size:13px;font-weight:500;line-height:22px;border-radius:0;text-align:left}
.backup-card button.help-disclosure{margin-top:12px;border-top:1px solid #edf0f6;color:#687a97;font-size:12px}
.help-disclosure>text:first-child{flex:1;min-width:0}
.help-chevron{flex:0 0 18px;color:#8291aa;font-size:17px;text-align:right}
.text-backup{padding-top:2px}
.help-page .paste-input{font-size:13px}
.help-page .import-panel{padding:14px;margin-top:16px}
.help-page .radio-row{align-items:flex-start;margin:18px 0}
.help-page .radio-row radio{flex-shrink:0;margin-left:-5px}
.restore-option{min-width:0;font-size:13px;line-height:1.7}
.restore-option .help-caption{margin-top:3px}
.help-side{min-width:0}
.help-guide .help-title{margin-bottom:8px}
.help-topic+.help-topic{border-top:1px solid #edf0f6}
.help-answer{padding:0 0 16px;color:#64738d;font-size:13px;line-height:1.8}
.transfer-step{display:flex;align-items:flex-start;gap:10px;margin-bottom:12px}
.step-number{flex:0 0 22px;background:#edf2ff;border-radius:7px;color:#365be5;font-size:12px;line-height:22px;text-align:center}
.help-about{text-align:center;color:#61728b;font-size:12px;line-height:1.8;padding:22px 10px 0}
.help-page button.help-share{width:auto;min-height:44px;display:inline-block;margin:8px 0 4px;padding:10px 12px;background:transparent;color:#365be5;font-size:13px;font-weight:600;line-height:24px}
@media(max-width:700px){.workspace,.help-grid{grid-template-columns:minmax(0,1fr)}}
