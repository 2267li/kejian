 0}.label{font-size:13px;font-weight:650;margin:15px 0 8px}.field{width:100%;height:44px;background:#f8f9fc;border:1px solid #dee4ef;border-radius:10px;padding:10px 12px;color:#263853}.picker{line-height:22px;font-size:13px}.disabled{color:#98a2b4}.field-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}.notes-input{height:110px;line-height:1.6}.text-button{display:inline-block;padding:9px 0;background:transparent;color:#5c709f;font-size:12px;font-weight:500}.action-row{display:flex;gap:10px;margin-top:18px}.grow{flex:1}.message{background:#edf3ff;border:1px solid #d4e2ff;color:#3b5d91;border-radius:12px;padding:13px 16px;margin-bottom:17px;line-height:1.6;font-size:13px}.danger{background:#fff0ee;color:#9c4b45;border-color:#f5d4d0}.board{max-width:760px;margin:0 auto}.board-top{display:flex;align-items:center;justify-content:space-between}.count-pill{border-radius:18px;padding:15px 20px;background:#e8edff;color:#365be5;font-size:28px;font-weight:750}.filters{display:flex;gap:6px;margin:20px 0}.filter{font-size:13px;padding:9px 18px;background:transparent;color:#7b88a0}.filter.active{background:#365be5;color:#fff}.task{padding:20px;margin-bottom:14px}.task-top{display:flex;align-items:flex-start;gap:13px}.check{width:27px;height:27px;min-width:27px;padding:0;margin:2px 0;background:#fff;border:2px solid #d4ddee;border-radius:9px;line-height:24px;font-size:17px}.check.checked{background:#e5ece8;border-color:#e5ece8;color:#588773}.task-body{flex:1;min-width:0}.task-title{font-size:17px;line-height:1.55;font-weight:650;word-break:break-all}.completed .task-title{text-decoration:line-through;color:#939dac}.task-meta{display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-top:10px}.tag{font-size:11px;background:#edf1fd;color:#526dba;padding:3px 8px;border-radius:6px}.late{color:#ba5c4c}.task-notes{color:#6b7890;font-size:13px;line-height:1.7;white-space:pre-wrap;word-break:break-all;margin-top:10px}.task-actions{display:flex;gap:20px;margin:10px 0 0 40px}.d